# ─────────────────────────────────────────────────────────────
# SERVER environment (apps/server)
#
# Copy to apps/server/.env. Every value is optional — the app runs
# with no configuration at all.
#
# This file is BACKEND-ONLY. Nothing here is ever sent to the
# browser: none of these names are prefixed VITE_, so Vite cannot
# bundle them even by accident. Client-safe values live in
# apps/web/.env.example.
#
# There are no API keys to leak in the first place: speech
# recognition runs locally, the translation API is free and
# keyless, and speech synthesis happens on the device.
# ─────────────────────────────────────────────────────────────

# Render injects PORT at runtime — do not hard-code it in production.
PORT=8787
NODE_ENV=development

# Bind address. 0.0.0.0 is required on Render; localhost would make the
# service unreachable and fail the health check.
HOST=0.0.0.0

# Comma-separated list of allowed browser origins, or * for any.
# Set this to your web app's deployed origin in production.
CORS_ORIGIN=*

# ── Speech to text: Whisper, running locally via Transformers.js
# Model weights download once on first run and are cached.
#   whisper-tiny   ~75MB   fastest, noticeably weaker on Arabic
#   whisper-base   ~145MB  the default — correct on Arabic, ~0.7s for 2s audio
#   whisper-small  ~480MB  best accuracy, several times slower
WHISPER_MODEL=onnx-community/whisper-base

# Quantisation. q8 is ~4x smaller and ~2x faster than fp32 with no
# meaningful accuracy loss at these model sizes.
WHISPER_DTYPE=q8

# Peak audio level below which a clip is treated as silence and never
# inferred. This gate matters: fed silence, Whisper invents words
# (it returns "you"), so raising this too far makes the app hallucinate.
WHISPER_SILENCE_THRESHOLD=0.006

# Load the model at boot instead of on the first user request.
WHISPER_WARMUP=true

# ── Translation: MyMemory (free, no key)
MYMEMORY_ENDPOINT=https://api.mymemory.translated.net/get

# Optional contact address. MyMemory raises the anonymous daily
# allowance from ~5,000 to ~50,000 characters when one is supplied.
# This is the single most useful setting in this file.
MYMEMORY_EMAIL=

# ── Text to speech
# None. The browser's speechSynthesis engine speaks the translation on
# the device — no key, no quota, no audio transferred.

# ── Provider mode
# real  = local Whisper + live MyMemory
# mock  = deterministic offline providers, no model download, no network
# auto  = same as "real" (kept for symmetry)
PROVIDER_MODE=auto

# ── Encryption at rest for the ephemeral audio buffer
# 32-byte key, hex or base64. Generated per-boot if omitted.
PAYLOAD_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Cost constraints (plan doc p.4). All enforced server-side —
# the client is never trusted to report its own usage.
#
# Recognition and synthesis are now free, so the only external
# allowance left is MyMemory's daily character budget. The session
# and time limits remain because unbounded CPU and unbounded
# microphone access are their own problems.
# ─────────────────────────────────────────────────────────────
QUOTA_DAILY_SECONDS=600           # max translation seconds per user per day
QUOTA_MONTHLY_SECONDS=9000        # max translation seconds per user per month
QUOTA_SESSION_SECONDS=120         # a session auto-stops at this length
QUOTA_MAX_CONCURRENT_PER_USER=1   # concurrent sessions per user
QUOTA_MAX_CONCURRENT_GLOBAL=25    # concurrent sessions across the whole app
QUOTA_GLOBAL_DAILY_SECONDS=36000  # app-wide daily audio ceiling

# MyMemory hard-rejects any query over 500 characters, so this is an
# upstream constraint rather than a policy choice.
QUOTA_MAX_CHARS_PER_TRANSLATION=500

# 16-bit 16kHz PCM is ~32KB/second, so this is roughly 4 minutes of audio.
QUOTA_MAX_AUDIO_BYTES=8000000

# App-wide daily ceiling on translated characters. Keep this under
# MyMemory's allowance: ~5,000 anonymous, ~50,000 with MYMEMORY_EMAIL set.
QUOTA_GLOBAL_DAILY_TRANSLATED_CHARS=4500

QUOTA_SESSION_IDLE_TIMEOUT_SECONDS=120

# ── A/B testing
AB_ENABLED=true
AB_SALT=auto-transliteration-v1
