# Copy to apps/web/.env.production and fill in your Render service hostname.
# Vite loads this automatically for `npm run build`.
#
# Note the schemes: https and wss. A production build pointing at ws:// from an
# https:// page is blocked by the browser as mixed content — it works locally
# and fails only once deployed, which is the worst way to find out.
VITE_API_URL=https://YOUR-SERVICE.onrender.com
VITE_WS_URL=wss://YOUR-SERVICE.onrender.com
