# ─────────────────────────────────────────────────────────────
# Auto Transliteration — server configuration
# Copy to `.env` at the repo root. NEVER ship these to the client.
# (Plan doc, p.4: "Never expose Google Cloud service-account
#  credentials in the mobile application.")
# ─────────────────────────────────────────────────────────────

PORT=8787
NODE_ENV=development

# ── Azure Speech-to-Text (plan doc p.2 — "Azure only does STT")
# Free tier: 5 audio hours / month
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ── Google Cloud Translation NMT (plan doc p.3)
# Free tier: first 500k characters / month
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_PROJECT_ID=

# ── Google Cloud Text-to-Speech (plan doc p.3)
# Free tier: 4M characters / month (Standard voices)
GOOGLE_TTS_API_KEY=

# If both Google services share a key, set this instead:
GOOGLE_API_KEY=

# ── Provider mode
# real  = call Azure/Google (requires the keys above)
# mock  = deterministic offline providers, no network, no spend
# auto  = "real" when the matching keys exist, otherwise "mock"
PROVIDER_MODE=auto

# ── Encryption at rest / in transit for the ephemeral audio buffer
# 32-byte key, hex or base64. Generated per-boot if omitted.
PAYLOAD_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Cost constraints (plan doc p.4). All enforced server-side —
# the client is never trusted to report its own usage.
# ─────────────────────────────────────────────────────────────
QUOTA_DAILY_SECONDS=600           # max translation seconds per user per day
QUOTA_MONTHLY_SECONDS=9000        # max translation seconds per user per month
QUOTA_SESSION_SECONDS=120         # a session auto-stops at this length
QUOTA_MAX_CONCURRENT_PER_USER=1   # concurrent sessions per user
QUOTA_MAX_CONCURRENT_GLOBAL=25    # concurrent sessions across the whole app
QUOTA_GLOBAL_DAILY_SECONDS=36000  # app-wide daily audio ceiling
QUOTA_MAX_CHARS_PER_TRANSLATION=800
QUOTA_MAX_AUDIO_BYTES=2000000     # ~2 MB per uploaded segment
QUOTA_GLOBAL_MONTHLY_TRANSLATED_CHARS=450000  # stay under Google's 500k free tier
QUOTA_GLOBAL_MONTHLY_TTS_CHARS=3800000        # stay under Google's 4M free tier

# ── A/B testing
AB_ENABLED=true
AB_SALT=auto-transliteration-v1
